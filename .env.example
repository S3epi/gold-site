# --- Server ---
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
LOG_LEVEL=info

# Comma separated list of allowed CORS origins (empty = same origin only)
CORS_ORIGIN=

# Token required for /api/v1/admin/* endpoints (change in production)
ADMIN_TOKEN=change-me-please

# --- Domestic provider (TGJU) ---
TGJU_ENABLED=true
TGJU_AJAX_URL=https://call1.tgju.org/ajax.json
TGJU_HISTORY_URL=https://api.tgju.org/v1/market/indicator/summary-table-data
DOMESTIC_INTERVAL_MS=60000

# --- International provider (gold-api.com, no key needed) ---
GOLDAPI_ENABLED=true
GOLDAPI_URL=https://api.gold-api.com/price/XAU
INTERNATIONAL_INTERVAL_MS=60000

# --- Optional secondary domestic providers (kept disabled by default) ---
NOBITEX_ENABLED=false
NOBITEX_URL=https://api.nobitex.ir/market/stats?srcCurrency=usdt&dstCurrency=rls
BONBAST_ENABLED=false
BONBAST_URL=https://bonbast.com/json

# --- Data quality ---
STALE_AFTER_MS=900000
LIVE_WITHIN_MS=180000
DISPUTE_THRESHOLD_PCT=2
OBSERVATION_MIN_SPACING_MS=300000

# --- History seeding ---
HISTORY_SEED_ENABLED=true
HISTORY_SEED_EVERY_MS=21600000
HISTORY_SEED_MAX_ROWS=20000
